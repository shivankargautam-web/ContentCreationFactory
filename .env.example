# Copy to .env and fill in. Leave AI keys empty to run with deterministic offline generators.
ENVIRONMENT=local
POSTGRES_USER=acf
POSTGRES_PASSWORD=acf
POSTGRES_DB=acf
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-32b
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:3000"]

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# true = simulate uploads (no real YouTube/Instagram calls) when no account is connected
PUBLISHING_DRY_RUN=true

# Empty = frontend proxies /api and /media to the backend (same origin)
NEXT_PUBLIC_API_URL=
MEDIA_PUBLIC_BASE_URL=/media
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
